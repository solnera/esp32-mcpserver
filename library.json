{
    "name": "ESP32-MCPServer",
    "version": "0.2.0",
    "description": "Model Context Protocol (MCP) Server library for ESP32. Implements MCP server functionality over HTTP/JSON-RPC, with tool calls executed on a worker task so blocking handlers never stall the async TCP task.",
    "keywords": "mcp, server, esp32, async, llm, ai",
    "repository": {
        "type": "git",
        "url": "https://github.com/solnera/esp32-mcpserver.git"
    },
    "authors": [
        {
            "name": "Solnera",
            "email": "liuyf1117@hotmail.com"
        }
    ],
    "license": "MIT",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "build": {
        "flags": [
            "-std=gnu++17"
        ],
        "unflags": [
            "-std=gnu++11"
        ]
    },
    "dependencies": {
        "bblanchon/ArduinoJson": "^7.0.0",
        "ESP32Async/ESPAsyncWebServer": "^3.6.0",
        "ESP32Async/AsyncTCP": "^3.3.2"
    }
}